{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Launch Chrome",
			"request": "launch",
			"type": "chrome",
			"url": "http://localhost:30000",
			"webRoot": "${workspaceFolder}/dist",
			// Foundry serves the system at /systems/talesoftheoldwest/ (a symlink to ./dist).
			// The sourcemap's sources (../../module/...) resolve to /systems/module/..., which is ./module.
			"pathMapping": {
				"/systems/talesoftheoldwest/": "${workspaceFolder}/dist/",
				"/systems/module/": "${workspaceFolder}/module/"
			},
			"resolveSourceMapLocations": ["**", "!**/node_modules/**"]
		}
	]
}
