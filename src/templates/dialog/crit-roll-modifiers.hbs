{{!--
  Crit Roll Modifiers dialog — Phase 6
  Context shape:
    attacks           — array of { messageId, label, targeted, ctx, isSelected } newest-first; may be empty
    defender          — { canRerollTens, canRerollUnits }
    preSelectedId     — messageId to pre-select, or null/"" for "None"
    selectedTensFixed — number|null: fixed tens of the pre-selected attack (called shot)
--}}
<section style="max-height: 70vh; overflow-y: auto;">

  {{!-- Attack dropdown --}}
  <div class="form-group" style="padding: 1em 1em 0 1em">
    <label style="color: black">{{localize "TALESOFTHEOLDWEST.dialog.CritAttack"}}</label>
    <select id="attackId" name="attackId">
      {{#each attacks}}
        <option value="{{this.messageId}}"{{#if (eq this.messageId ../preSelectedId)}} selected{{/if}}>
          {{this.label}}{{#if this.targeted}} {{localize "TALESOFTHEOLDWEST.dialog.CritTargeted"}}{{/if}}
        </option>
      {{/each}}
      <option value=""{{#unless preSelectedId}} selected{{/unless}}>
        {{localize "TALESOFTHEOLDWEST.dialog.CritNone"}}
      </option>
    </select>
  </div>

  {{!-- One block per attack; only the pre-selected one is visible (dropdown handled by _wireCritAttackSelect) --}}
  {{#each attacks}}
  <div data-attack-block="{{this.messageId}}"{{#if this.ctx.tens.fixed}} data-tens-fixed="{{this.ctx.tens.fixed}}"{{/if}} style="{{#unless this.isSelected}}display: none; {{/unless}}padding: 0 1em;">

    {{!-- Tens die info --}}
    <div class="form-group" style="padding: 0.5em 0 0 0">
      <label style="color: black">{{localize "TALESOFTHEOLDWEST.dialog.CritTensDie"}}</label>
      <span style="color: black">
        {{#if this.ctx.tens.fixed}}
          {{localize "TALESOFTHEOLDWEST.dialog.CritTensFixed"}} {{this.ctx.tens.fixed}}
        {{else}}
          —
        {{/if}}
      </span>
    </div>

    {{!-- Units bonuses list --}}
    {{#if this.ctx.units}}
    <div class="form-group" style="padding: 0.25em 0 0 0">
      <label style="color: black">{{localize "TALESOFTHEOLDWEST.dialog.CritUnitsDie"}}</label>
      <ul style="margin: 0; padding-left: 1.25em; color: black">
        {{#each this.ctx.units}}
          <li>{{this.label}}: +{{this.value}}</li>
        {{/each}}
      </ul>
    </div>
    {{/if}}

    {{!-- Fanning checkbox — only shown for a fanned attack (pre-ticked).
         Name is unique per attack: a shared name makes FormDataExtended return an array
         (always truthy) when more than one attack is listed. --}}
    {{#if this.ctx.fanning}}
    <div class="form-group" style="padding: 0.25em 0 0.5em 0; display: flex; align-items: center; gap: 8px;">
      <label class="resource-label" style="color: black; flex: 0 0 auto;">
        {{localize "TALESOFTHEOLDWEST.dialog.CritFanning"}}
      </label>
      <input type="checkbox"
             name="fanning-{{this.messageId}}"
             data-fanning
             checked
             {{#unless this.isSelected}}disabled{{/unless}} />
    </div>
    {{/if}}

  </div>
  {{/each}}

  {{!-- Lucky reroll tickboxes (outside attack blocks; the template sets the initial state
       and _wireCritAttackSelect updates it when the dropdown changes) --}}
  {{#if defender.canRerollTens}}
  <div class="form-group" id="rerollTensGroup" style="padding: 0.5em 1em 0 1em; display: flex; align-items: center; gap: 8px;">
    <label class="resource-label" style="color: black; flex: 0 0 auto;">
      {{localize "TALESOFTHEOLDWEST.dialog.CritLuckyTens"}}
    </label>
    <input type="checkbox" name="rerollTens" id="rerollTens" {{disabled selectedTensFixed}} />
    <span id="rerollTensNote" style="color: #888; font-size: 0.85em;{{#unless selectedTensFixed}} display: none;{{/unless}}">
      {{localize "TALESOFTHEOLDWEST.dialog.CritLuckyTensBlocked"}}
    </span>
  </div>
  {{/if}}

  {{#if defender.canRerollUnits}}
  <div class="form-group" style="padding: 0.5em 1em 0 1em; display: flex; align-items: center; gap: 8px;">
    <label class="resource-label" style="color: black; flex: 0 0 auto;">
      {{localize "TALESOFTHEOLDWEST.dialog.CritLuckyUnits"}}
    </label>
    <input type="checkbox" name="rerollUnits" id="rerollUnits" />
  </div>
  {{/if}}

  {{!-- Manual override fields (blank = roll normally) --}}
  <div class="form-group" style="padding: 0.5em 1em 0.5em 1em; display: flex; align-items: center; gap: 8px;">
    <label style="color: black; flex: 1 1 auto;">{{localize "TALESOFTHEOLDWEST.dialog.CritManualOverrides"}}</label>
    <label for="manualTens" style="color: black; flex: 0 0 auto;">{{localize "TALESOFTHEOLDWEST.dialog.CritTens"}}</label>
    <select name="manualTens" id="manualTens" style="width: 4em; flex: 0 0 auto;" {{disabled selectedTensFixed}}>
      <option value=""{{#unless selectedTensFixed}} selected{{/unless}}></option>
      <option value="1"{{#if (eq selectedTensFixed 1)}} selected{{/if}}>1</option>
      <option value="2"{{#if (eq selectedTensFixed 2)}} selected{{/if}}>2</option>
      <option value="3"{{#if (eq selectedTensFixed 3)}} selected{{/if}}>3</option>
      <option value="4"{{#if (eq selectedTensFixed 4)}} selected{{/if}}>4</option>
      <option value="5"{{#if (eq selectedTensFixed 5)}} selected{{/if}}>5</option>
      <option value="6"{{#if (eq selectedTensFixed 6)}} selected{{/if}}>6</option>
    </select>
    <label for="manualUnits" style="color: black; flex: 0 0 auto;">{{localize "TALESOFTHEOLDWEST.dialog.CritUnits"}}</label>
    <select name="manualUnits" id="manualUnits" style="width: 4em; flex: 0 0 auto;">
      <option value="" selected></option>
      <option value="1">1</option>
      <option value="2">2</option>
      <option value="3">3</option>
      <option value="4">4</option>
      <option value="5">5</option>
      <option value="6">6</option>
    </select>
  </div>

</section>
