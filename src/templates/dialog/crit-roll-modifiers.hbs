{{!--
  Crit Roll Modifiers dialog — Phase 6
  Context shape:
    attacks       — array of { messageId, label, targeted, ctx } newest-first; may be empty
    defender      — { canRerollTens, canRerollUnits }
    preSelectedId — messageId to pre-select, or null/"" for "None"
--}}
<section style="max-height: 70vh; overflow-y: auto;">

  {{!-- Attack dropdown --}}
  <div class="form-group" style="padding: 1em 1em 0 1em">
    <label style="color: black">{{localize "TALESOFTHEOLDWEST.dialog.CritAttack"}}</label>
    <select id="attackId" name="attackId">
      {{#each attacks}}
        <option value="{{this.messageId}}"{{#if (eq this.messageId ../preSelectedId)}} selected{{/if}}>
          {{this.label}}{{#if this.targeted}} {{localize "TALESOFTHEOLDWEST.dialog.CritTargeted"}}{{/if}}
        </option>
      {{/each}}
      <option value=""{{#unless preSelectedId}} selected{{/unless}}>
        {{localize "TALESOFTHEOLDWEST.dialog.CritNone"}}
      </option>
    </select>
  </div>

  {{!-- One hidden block per attack --}}
  {{#each attacks}}
  <div data-attack-block="{{this.messageId}}" style="display: none; padding: 0 1em;">

    {{!-- Tens die info --}}
    <div class="form-group" style="padding: 0.5em 0 0 0">
      <label style="color: black">{{localize "TALESOFTHEOLDWEST.dialog.CritTensDie"}}</label>
      <span style="color: black">
        {{#if this.ctx.tens.fixed}}
          {{localize "TALESOFTHEOLDWEST.dialog.CritTensFixed"}} {{this.ctx.tens.fixed}}
        {{else}}
          —
        {{/if}}
      </span>
    </div>

    {{!-- Units bonuses list --}}
    {{#if this.ctx.units}}
    <div class="form-group" style="padding: 0.25em 0 0 0">
      <label style="color: black">{{localize "TALESOFTHEOLDWEST.dialog.CritUnitsDie"}}</label>
      <ul style="margin: 0; padding-left: 1.25em; color: black">
        {{#each this.ctx.units}}
          <li>{{this.label}}: +{{this.value}}</li>
        {{/each}}
      </ul>
    </div>
    {{/if}}

    {{!-- Fanning checkbox — disabled when tens.fixed is set --}}
    <div class="form-group" style="padding: 0.25em 0 0.5em 0; display: flex; align-items: center; gap: 8px;">
      <label class="resource-label" style="color: black; flex: 0 0 auto;">
        {{localize "TALESOFTHEOLDWEST.dialog.CritFanning"}}
      </label>
      <input type="checkbox"
             name="fanning"
             {{#if this.ctx.fanning}}checked{{/if}}
             {{#if this.ctx.tens.fixed}}disabled{{/if}} />
    </div>

  </div>
  {{/each}}

  {{!-- Lucky reroll tickboxes (outside hidden blocks; JS updates disabled state) --}}
  {{#if defender.canRerollTens}}
  <div class="form-group" id="rerollTensGroup" style="padding: 0.5em 1em 0 1em; display: flex; align-items: center; gap: 8px;">
    <label class="resource-label" style="color: black; flex: 0 0 auto;">
      {{localize "TALESOFTHEOLDWEST.dialog.CritLuckyTens"}}
    </label>
    <input type="checkbox" name="rerollTens" id="rerollTens" />
    <span id="rerollTensNote" style="color: #888; font-size: 0.85em; display: none;">
      {{localize "TALESOFTHEOLDWEST.dialog.CritLuckyTensBlocked"}}
    </span>
  </div>
  {{/if}}

  {{#if defender.canRerollUnits}}
  <div class="form-group" style="padding: 0.5em 1em 0 1em; display: flex; align-items: center; gap: 8px;">
    <label class="resource-label" style="color: black; flex: 0 0 auto;">
      {{localize "TALESOFTHEOLDWEST.dialog.CritLuckyUnits"}}
    </label>
    <input type="checkbox" name="rerollUnits" id="rerollUnits" />
  </div>
  {{/if}}

  {{!-- Manual override fields --}}
  <div class="form-group" style="padding: 0.5em 1em 0 1em">
    <label style="color: black">{{localize "TALESOFTHEOLDWEST.dialog.CritManualTens"}}</label>
    <input type="number" name="manualTens" id="manualTens" min="1" max="6" style="width: 50px" />
  </div>
  <div class="form-group" style="padding: 0.5em 1em 0.5em 1em">
    <label style="color: black">{{localize "TALESOFTHEOLDWEST.dialog.CritManualUnits"}}</label>
    <input type="number" name="manualUnits" id="manualUnits" min="1" max="6" style="width: 50px" />
  </div>

</section>

<script>
(function () {
  // Build a lookup of messageId → ctx from data embedded in the DOM.
  // We reconstruct it from the attack-block data attributes and hidden fields.
  const attackData = {};
  document.querySelectorAll('[data-attack-block]').forEach(function (el) {
    const id = el.dataset.attackBlock;
    const tensFixedEl  = el.querySelector('[data-tens-fixed]');
    const tensFixed    = tensFixedEl ? Number(tensFixedEl.dataset.tensFixed) || null : null;
    attackData[id] = { tensFixed };
  });

  // Embed the ctx data as JSON in hidden elements so JS can read it without Handlebars globals.
  {{#each attacks}}
  attackData["{{this.messageId}}"] = { tensFixed: {{#if this.ctx.tens.fixed}}{{this.ctx.tens.fixed}}{{else}}null{{/if}} };
  {{/each}}

  function applyAttackSelection(selectedId) {
    // Hide all attack blocks and disable their checkboxes (prevents ghost form data).
    document.querySelectorAll('[data-attack-block]').forEach(function (el) {
      el.style.display = 'none';
      el.querySelectorAll('input').forEach(function (inp) { inp.disabled = true; });
    });

    // Show the selected block and re-enable its inputs.
    if (selectedId) {
      var block = document.querySelector('[data-attack-block="' + selectedId + '"]');
      if (block) {
        block.style.display = '';
        block.querySelectorAll('input').forEach(function (inp) {
          // Fanning stays disabled when tens.fixed is set — honour original disabled state.
          if (inp.name === 'fanning' && attackData[selectedId] && attackData[selectedId].tensFixed !== null) {
            inp.disabled = true;
          } else {
            inp.disabled = false;
          }
        });
      }
    }

    // Update Lucky Tens disabled state.
    var rerollTens = document.getElementById('rerollTens');
    var rerollTensNote = document.getElementById('rerollTensNote');
    if (rerollTens) {
      var tensFixed = selectedId && attackData[selectedId] ? attackData[selectedId].tensFixed : null;
      var blocked   = tensFixed !== null && tensFixed !== undefined;
      rerollTens.disabled = blocked;
      if (rerollTensNote) rerollTensNote.style.display = blocked ? '' : 'none';
      if (blocked) rerollTens.checked = false;
    }

    // Pre-fill manualTens when a fixed tens is present.
    var manualTens = document.getElementById('manualTens');
    if (manualTens) {
      var ctx = selectedId && attackData[selectedId] ? attackData[selectedId] : null;
      if (ctx && ctx.tensFixed !== null && ctx.tensFixed !== undefined) {
        manualTens.value    = ctx.tensFixed;
        manualTens.disabled = true;
      } else {
        manualTens.value    = '';
        manualTens.disabled = false;
      }
    }
  }

  // Wire dropdown.
  var dropdown = document.getElementById('attackId');
  if (dropdown) {
    dropdown.addEventListener('change', function () {
      applyAttackSelection(this.value);
    });
    // Apply on load for whatever is pre-selected.
    applyAttackSelection(dropdown.value);
  }
}());
</script>
