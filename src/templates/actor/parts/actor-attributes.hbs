<div class="heading" style="padding-left: 20px">
	{{toUpperCase (localize 'TALESOFTHEOLDWEST.General.attributes')}} {{toUpperCase (localize 'TALESOFTHEOLDWEST.General.and')}} {{toUpperCase (localize
	'TALESOFTHEOLDWEST.General.abilities')}}
</div>
<div class="sheet-main-attributes">
	<div class="A1 main-attributes">
		<label for="system.attributes.grit" class="resource-label rollable align-left" data-tooltip='{{localize "TALESOFTHEOLDWEST.General.rightclicktomodify"}}' data-roll-type="attribute" data-action="roll" data-label='{{localize "TALESOFTHEOLDWEST.Attributes.grit.name"}}' data-mod="{{system.attributes.grit.mod}}" data-key="grit" data-speaker='{{actor.id}}'>{{toUpperCase (localize 'TALESOFTHEOLDWEST.Attributes.grit.name')}}</label>
	</div>
	<div class="B1">
		<input class="statnum" type='number' name="system.attributes.grit.value" value="{{system.attributes.grit.value}}" data-dtype='Number' />
		<span style="font-weight: bolder; font-size: x-large">/</span>
		<input class="statnum" type='number' name="system.attributes.grit.max" value="{{system.attributes.grit.max}}" data-dtype='Number' />
	</div>

	<div class="A2 main-attributes">
		<label for="system.attributes.quick" class="resource-label rollable align-left" data-tooltip='{{localize "TALESOFTHEOLDWEST.General.rightclicktomodify"}}' data-roll-type="attribute" data-action="roll" data-label='{{localize "TALESOFTHEOLDWEST.Attributes.quick.name"}}' data-mod="{{system.attributes.quick.mod}}" data-key="quick" data-speaker='{{actor.id}}'>{{toUpperCase (localize 'TALESOFTHEOLDWEST.Attributes.quick.name')}}</label>
	</div>
	<div class="B2">
		<input class="statnum" type='number' name="system.attributes.quick.value" value="{{system.attributes.quick.value}}" data-dtype='Number' />
		<span style="font-weight: bolder; font-size: x-large">/</span>
		<input class="statnum" type='number' name="system.attributes.quick.max" value="{{system.attributes.quick.max}}" data-dtype='Number' />
	</div>

	<div class="A3 main-attributes">
		<label for="system.attributes.cunning" class="resource-label rollable align-left" data-tooltip='{{localize "TALESOFTHEOLDWEST.General.rightclicktomodify"}}' data-roll-type="attribute" data-action="roll" data-label='{{localize "TALESOFTHEOLDWEST.Attributes.cunning.name"}}' data-mod="{{system.attributes.cunning.mod}}" data-key="cunning" data-speaker='{{actor.id}}'>{{toUpperCase (localize 'TALESOFTHEOLDWEST.Attributes.cunning.name')}}</label>
	</div>
	<div class="B3">
		<input class="statnum" type='number' name="system.attributes.cunning.value" value="{{system.attributes.cunning.value}}" data-dtype='Number' />
		<span style="font-weight: bolder; font-size: x-large">/</span>
		<input class="statnum" type='number' name="system.attributes.cunning.max" value="{{system.attributes.cunning.max}}" data-dtype='Number' />
	</div>

	<div class="A4 main-attributes">
		<label for="system.attributes.docity" class="resource-label rollable align-left" data-tooltip='{{localize "TALESOFTHEOLDWEST.General.rightclicktomodify"}}' data-roll-type="attribute" data-action="roll" data-label='{{localize "TALESOFTHEOLDWEST.Attributes.docity.name"}}' data-mod="{{system.attributes.docity.mod}}" data-key="docity" data-speaker='{{actor.id}}'>{{toUpperCase (localize 'TALESOFTHEOLDWEST.Attributes.docity.name')}}</label>
	</div>
	<div class="B4">
		<input class="statnum" type='number' name="system.attributes.docity.value" value="{{system.attributes.docity.value}}" data-dtype='Number' />
		<span style="font-weight: bolder; font-size: x-large">/</span>
		<input class="statnum" type='number' name="system.attributes.docity.max" value="{{system.attributes.docity.max}}" data-dtype='Number' />
	</div>

	<div class="H1 heading">
		<label for="system.attributes.grit.type" class="resource-label" data-label='{{localize "TALESOFTHEOLDWEST.Attributes.grit.type"}}'><em>{{capitalise (localize 'TALESOFTHEOLDWEST.Attributes.grit.type')}}</em></label>
	</div>

	<div class="H2 newdots HedCol12" data-action="changeDamage" data-label='{{localize "TALESOFTHEOLDWEST.Attributes.grit.type"}}' data-attribute='{{localize "TALESOFTHEOLDWEST.Attributes.grit.listName"}}' data-tooltip="{{localize 'TALESOFTHEOLDWEST.General.leftToAdd'}}">
		{{#times system.damage.hurts.value}}
		<a class="far fa-dot-circle"></a>
		{{/times}} {{#times system.damage.hurts.max}}<a class="far fa-circle"></a>{{/times}}
	</div>

	<div class="S1 heading">
		<label for="system.attributes.quick.type" class="resource-label" data-label='{{localize "TALESOFTHEOLDWEST.Attributes.quick.type"}}'><em>{{capitalise (localize 'TALESOFTHEOLDWEST.Attributes.quick.type')}}</em></label>
	</div>

	<div class="S2 newdots HedCol12" data-action="changeDamage" data-label='{{localize "TALESOFTHEOLDWEST.Attributes.quick.type"}}' data-attribute='{{localize "TALESOFTHEOLDWEST.Attributes.quick.listName"}}' data-tooltip="{{localize 'TALESOFTHEOLDWEST.General.leftToAdd'}}">
		{{#times system.damage.shakes.value}}
		<a class="far fa-dot-circle"></a>
		{{/times}} {{#times system.damage.shakes.max}}<a class="far fa-circle"></a>{{/times}}
	</div>
	<div class="V1 	heading">
		<label for="system.attributes.cunning.type" class="resource-label" data-label='{{localize "TALESOFTHEOLDWEST.Attributes.cunning.type"}}'><em>{{capitalise (localize 'TALESOFTHEOLDWEST.Attributes.cunning.type')}}</em></label>
	</div>
	<div class="V2 newdots HedCol12" data-action="changeDamage" data-label='{{localize "TALESOFTHEOLDWEST.Attributes.cunning.type"}}' data-attribute='{{localize "TALESOFTHEOLDWEST.Attributes.cunning.listName"}}' data-tooltip="{{localize 'TALESOFTHEOLDWEST.General.leftToAdd'}}">
		{{#times system.damage.vexes.value}}
		<a class="far fa-dot-circle"></a>
		{{/times}} {{#times system.damage.vexes.max}}<a class="far fa-circle"></a>{{/times}}
	</div>

	<div class="D1 heading">
		<label for="system.attributes.docity.type" class="resource-label" data-label='{{localize "TALESOFTHEOLDWEST.Attributes.docity.type"}}'><em>{{capitalise (localize 'TALESOFTHEOLDWEST.Attributes.docity.type')}}</em></label>
	</div>
	<div class="D2 newdots HedCol12" data-action="changeDamage" data-label='{{localize "TALESOFTHEOLDWEST.Attributes.docity.type"}}' data-attribute='{{localize "TALESOFTHEOLDWEST.Attributes.docity.listName"}}' data-tooltip="{{localize 'TALESOFTHEOLDWEST.General.leftToAdd'}}">
		{{#times system.damage.doubts.value}}
		<a class="far fa-dot-circle"></a>
		{{/times}} {{#times system.damage.doubts.max}}<a class="far fa-circle"></a>{{/times}}
	</div>
</div>
<div class="sheet-main-abilities">
	{{#each system.abilities as |ability key|}}
	<div class="abilities-name {{key}}">
		<label class="resource-label rollable" for="system.abilities.{{key}}.value" data-tooltip='{{localize "TALESOFTHEOLDWEST.General.rightclicktomodify"}}' data-roll-type="ability" data-action="roll" data-value="{{ability.value}}" data-label="{{ability.label}}" data-stunts="{{ability.label}}" data-mod="{{ability.mod}}" data-key="{{key}}" data-attr="{{ability.attr}}" data-speaker='{{actor.id}}'>{{ability.upper}}</label>
	</div>
	<div class="{{key}}2" style="text-align: center">
		<input class="statnum" type='number' name="system.abilities.{{key}}.value" value="{{ability.value}}" data-dtype='Number' />
	</div>
	{{/each}}
</div>
