<div class="sheet-animal-attributes animal-stats ">
	<div class="aA1 main-attributes">
		<label for="system.attributes.grit" class="resource-label rollable align-left" data-tooltip='{{localize "TALESOFTHEOLDWEST.General.rightclicktomodify"}}' data-roll-type="attribute" data-action="roll" data-label='{{localize "TALESOFTHEOLDWEST.Attributes.grit.name"}}' data-mod="{{system.attributes.grit.mod}}" data-key="grit" data-speaker='{{actor.id}}'>{{toUpperCase (localize 'TALESOFTHEOLDWEST.Attributes.grit.name')}}</label>
	</div>
	<div class="aB1">
		<input class="statnum" type='number' name="system.attributes.grit.value" value="{{system.attributes.grit.value}}" data-dtype='Number' />
		<span style="font-weight: bolder; font-size: x-large">/</span>
		<input class="statnum" type='number' name="system.attributes.grit.max" value="{{system.attributes.grit.max}}" data-dtype='Number' />
	</div>

	<div class="aA2 main-attributes">
		<label for="system.attributes.quick" class="resource-label rollable align-left" data-tooltip='{{localize "TALESOFTHEOLDWEST.General.rightclicktomodify"}}' data-roll-type="attribute" data-action="roll" data-label='{{localize "TALESOFTHEOLDWEST.Attributes.quick.name"}}' data-mod="{{system.attributes.quick.mod}}" data-key="quick" data-speaker='{{actor.id}}'>{{toUpperCase (localize 'TALESOFTHEOLDWEST.Attributes.quick.name')}}</label>
	</div>
	<div class="aB2">
		<input class="statnum" type='number' name="system.attributes.quick.value" value="{{system.attributes.quick.value}}" data-dtype='Number' />
		<span style="font-weight: bolder; font-size: x-large">/</span>
		<input class="statnum" type='number' name="system.attributes.quick.max" value="{{system.attributes.quick.max}}" data-dtype='Number' />
	</div>
	<div class="aA3 main-attributes">
		<label for="system.attributes.cunning" class="resource-label rollable align-left" data-tooltip='{{localize "TALESOFTHEOLDWEST.General.rightclicktomodify"}}' data-roll-type="attribute" data-action="roll" data-label='{{localize "TALESOFTHEOLDWEST.Attributes.cunning.name"}}' data-mod="{{system.attributes.cunning.mod}}" data-key="cunning" data-speaker='{{actor.id}}'>{{toUpperCase (localize 'TALESOFTHEOLDWEST.Attributes.cunning.name')}}</label>
	</div>
	<div class="aB3">
		<input class="statnum" type='number' name="system.attributes.cunning.value" value="{{system.attributes.cunning.value}}" data-dtype='Number' />
		<span style="font-weight: bolder; font-size: x-large">/</span>
		<input class="statnum" type='number' name="system.attributes.cunning.max" value="{{system.attributes.cunning.max}}" data-dtype='Number' />
	</div>

	<div class="aH1 heading">
		<label class="resource-label" data-label='{{localize "TALESOFTHEOLDWEST.Attributes.grit.type"}}'><em>{{capitalise (localize 'TALESOFTHEOLDWEST.Attributes.grit.type')}}</em></label>
	</div>
	<div class="aH2 newdots" data-action="changeDamage" data-label='{{localize "TALESOFTHEOLDWEST.Attributes.grit.type"}}' data-attribute='{{localize "TALESOFTHEOLDWEST.Attributes.grit.listName"}}' data-tooltip="{{localize 'TALESOFTHEOLDWEST.General.leftToAdd'}}">
		{{#times system.damage.hurts.value}}<a class="far fa-dot-circle"></a>{{/times}}
		{{#times system.damage.hurts.max}}<a class="far fa-circle"></a>{{/times}}
	</div>
	<div class="aS1 heading">
		<label class="resource-label" data-label='{{localize "TALESOFTHEOLDWEST.Attributes.quick.type"}}'><em>{{capitalise (localize 'TALESOFTHEOLDWEST.Attributes.quick.type')}}</em></label>
	</div>
	<div class="aS2 newdots" data-action="changeDamage" data-label='{{localize "TALESOFTHEOLDWEST.Attributes.quick.type"}}' data-attribute='{{localize "TALESOFTHEOLDWEST.Attributes.quick.listName"}}' data-tooltip="{{localize 'TALESOFTHEOLDWEST.General.leftToAdd'}}">
		{{#times system.damage.shakes.value}}<a class="far fa-dot-circle"></a>{{/times}}
		{{#times system.damage.shakes.max}}<a class="far fa-circle"></a>{{/times}}
	</div>
	<div class="aV1 heading">
		<label class="resource-label" data-label='{{localize "TALESOFTHEOLDWEST.Attributes.cunning.type"}}'><em>{{capitalise (localize 'TALESOFTHEOLDWEST.Attributes.cunning.type')}}</em></label>
	</div>
	<div class="aV2 newdots" data-action="changeDamage" data-label='{{localize "TALESOFTHEOLDWEST.Attributes.cunning.type"}}' data-attribute='{{localize "TALESOFTHEOLDWEST.Attributes.cunning.listName"}}' data-tooltip="{{localize 'TALESOFTHEOLDWEST.General.leftToAdd'}}">
		{{#times system.damage.vexes.value}}<a class="far fa-dot-circle"></a>{{/times}}
		{{#times system.damage.vexes.max}}<a class="far fa-circle"></a>{{/times}}
	</div>
</div>
<div style="padding: 0.5em 0 0.5em 0;">
	<label class="resource-label" style="font-size: 1.5em" data-action="rollCrit">{{ localize 'TYPES.Item.crit'}}</label>
	<a class="resource-label-header" data-tooltip="{{localize 'TALESOFTHEOLDWEST.General.leftclicktoroll'}}" data-action="rollCrit"><i class="fas fa-heartbeat"></i></a>
</div>
{{#if (eq actor.system.general.subtype 'horse')}}
{{>"systems/talesoftheoldwest/templates/actor/parts/actor-animal-horse.hbs"}}
{{else}}
{{>"systems/talesoftheoldwest/templates/actor/parts/actor-animal-generic.hbs"}}
{{/if}}
<div style="justify-self: anchor-center">
	<label for="system.biography" class="heading">{{toUpperCase (localize 'TALESOFTHEOLDWEST.General.description')}}</label>
</div>
<div class="div-border horse-description-box">
	{{#if editable}}
	<prose-mirror name="system.biography" style="height: -webkit-fill-available;" data-document-u-u-i-d="{{actor.uuid}}" value="{{system.biography}}" collaborate='true' toggled="true">
		{{{enrichedBiography}}}
	</prose-mirror>
	{{else}}
	{{{enrichedBiography}}}
	{{/if}}
</div>
