<div class="crit-and-conditions" style="padding-left: 10px; margin-bottom: 10px">
	<div class="heading">
		{{toUpperCase (localize 'TALESOFTHEOLDWEST.General.criticalInjurys')}} / {{toUpperCase (localize 'TALESOFTHEOLDWEST.General.conditions')}}
	</div>
	<div>
		<label class="resource-label" style="font-size: 1.5em" data-action="rollCrit">{{ localize 'TYPES.Item.crit'}}</label>
		<a class="resource-label-header" data-tooltip="{{localize 'TALESOFTHEOLDWEST.General.leftclicktoroll'}}" data-action="rollCrit"><i class="fas fa-heartbeat"></i></a>
	</div>
	<div class="grid-crit">
		<ol class="items-list">
			{{#each system.critInj as |item iid|}}
			<li class="item critical-inj" data-item-id="{{item.id}}" data-drag="true" data-document-class="Critical Injury">
				<div class="item-image crit1"><img src="{{item.img}}" width="24" height="24" /></div>
				<div class="crit2">{{item.name}}</div>
				<div class="crit3">
					<p>
						<strong> {{localize 'TALESOFTHEOLDWEST.Criticals.imediateeffect'}} :</strong> {{striptags item.system.imediateeffect}} <br />
						<strong> {{localize 'TALESOFTHEOLDWEST.Criticals.longtermeffect'}} : </strong> {{removeMarkup item.system.longtermeffect}}
					</p>
				</div>
				<div class="item-controls crit4">
					<a class="item-control item-edit" data-action="viewDoc" data-actor="{{actor.id}}" data-tooltip='{{localize "DOCUMENT.Update" type="Item"}}'>
						<i class="fas fa-edit"></i>
					</a>
					<a class="item-control item-delete" data-action="deleteDoc" data-type="criticalinj" data-actor="{{actor.id}}" data-tooltip='{{localize "DOCUMENT.Delete" type="Item"}}'>
						<i class="fas fa-trash"></i>
					</a>
				</div>
			</li>
			{{/each}}
		</ol>
	</div>
	<div class="conditionHeading">
		<label class="dots resource-label" style="padding-right: 15px" data-status-id="starving" data-key="starving" data-tooltip="{{ localize 'TALESOFTHEOLDWEST.General.leftToAdd'}}">
			{{ localize 'TALESOFTHEOLDWEST.Conditions.Starving'}}
			<a class="overwatch-toggle" data-action="toggleCondition" data-status-id="starving" data-key="starving">
				{{#each statuses as |status id|}}
				{{#if (eq status.name 'TALESOFTHEOLDWEST.Conditions.Starving')}}
				{{#if status.active}}
				<i class="far fa-dot-circle"></i>
				{{else}}
				<i class="far fa-circle"></i>
				{{/if}}
				{{/if}}
				{{/each}}
			</a>
		</label>
		<label class="dots resource-label" style="padding-right: 15px" data-status-id="dehydrated" data-key="dehydrated" data-tooltip="{{ localize 'TALESOFTHEOLDWEST.General.leftToAdd'}}">
			{{ localize 'TALESOFTHEOLDWEST.Conditions.Dehydrated'}}
			<a class="overwatch-toggle" data-action="toggleCondition" data-status-id="dehydrated" data-key="dehydrated">
				{{#each statuses as |status id|}}
				{{#if (eq status.name 'TALESOFTHEOLDWEST.Conditions.Dehydrated')}}
				{{#if status.active}}
				<i class="far fa-dot-circle"></i>
				{{else}}
				<i class="far fa-circle"></i>
				{{/if}}
				{{/if}}
				{{/each}}
			</a>
		</label>
		<label class="dots resource-label" style="padding-right: 15px" data-status-id="exhausted" data-key="exhausted" data-tooltip="{{ localize 'TALESOFTHEOLDWEST.General.leftToAdd'}}">
			{{ localize 'TALESOFTHEOLDWEST.Conditions.Exhausted'}}
			<a class="overwatch-toggle" data-action="toggleCondition" data-status-id="exhausted" data-key="exhausted">
				{{#each statuses as |status id|}}
				{{#if (eq status.name 'TALESOFTHEOLDWEST.Conditions.Exhausted')}}
				{{#if status.active}}
				<i class="far fa-dot-circle"></i>
				{{else}}
				<i class="far fa-circle"></i>
				{{/if}}
				{{/if}}
				{{/each}}
			</a>
		</label>
		<label class="dots resource-label" style="padding-right: 15px" data-status-id="freezing" data-key="freezing" data-tooltip="{{ localize 'TALESOFTHEOLDWEST.General.leftToAdd'}}">
			{{ localize 'TALESOFTHEOLDWEST.Conditions.Freezing'}}
			<a class="overwatch-toggle" data-action="toggleCondition" data-status-id="freezing" data-key="freezing">
				{{#each statuses as |status id|}}
				{{#if (eq status.name 'TALESOFTHEOLDWEST.Conditions.Freezing')}}
				{{#if status.active}}
				<i class="far fa-dot-circle"></i>
				{{else}}
				<i class="far fa-circle"></i>
				{{/if}}
				{{/if}}
				{{/each}}
			</a>
		</label>
		<label class="dots resource-label" data-status-id="heatstroke" data-key="heatstroke" data-tooltip="{{ localize 'TALESOFTHEOLDWEST.General.leftToAdd'}}">
			{{ localize 'TALESOFTHEOLDWEST.Conditions.Heatstroke'}}
			<a class="overwatch-toggle" data-action="toggleCondition" data-status-id="heatstroke" data-key="heatstroke">
				{{#each statuses as |status id|}}
				{{#if (eq status.name 'TALESOFTHEOLDWEST.Conditions.Heatstroke')}}
				{{#if status.active}}
				<i class="far fa-dot-circle"></i>
				{{else}}
				<i class="far fa-circle"></i>
				{{/if}}
				{{/if}}
				{{/each}}
			</a>
		</label>
	</div>
</div>
